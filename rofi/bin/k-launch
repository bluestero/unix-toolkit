#!/usr/bin/env bash
# k-launch [apps|ssh|filebrowser|power|settings|speaker|mic|wifi|bluetooth]: the rofi launcher, as Alt+Space / Alt+Shift+Space run it.
#  - not open: opens it and gives it the keyboard (rofi is an X11 program, so GNOME
#    doesn't focus it on its own);
#  - open and you are in another window: brings it back to the front;
#  - open and focused: closes it (same key toggles);
#  - you switch to another window, minimize or click away: it closes by itself.
# Needs the Window Calls GNOME extension (./install.sh window-calls) for the focus
# part; without it rofi still opens, it just doesn't follow focus.
set -uo pipefail
mode=${1:-apps}
[[ "$mode" == drun ]] && mode=apps   # old name, same tab
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# settings = its own set of tabs (speaker, mic, wifi, bluetooth); Ctrl+Tab / Ctrl+Shift+Tab cycle them
modi="apps:$here/k-apps,ssh,filebrowser,power:$here/k-power"
case "$mode" in
  settings|speaker|mic|wifi|bluetooth)
    modi="speaker:$here/k-speaker,mic:$here/k-mic,wifi:$here/k-wifi,bluetooth:$here/k-bluetooth"
    [[ "$mode" == settings ]] && mode=speaker ;;
esac
WC=(gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell/Extensions/Windows)

# prints "<id> <true|false>" for rofi's window, nothing if there is none
rofi_win() {
  local o
  o=$("${WC[@]}" --method org.gnome.Shell.Extensions.Windows.List 2>/dev/null |
    grep -o '{[^{}]*"wm_class":"Rofi"[^{}]*}') || return 1
  [[ -n "$o" ]] || return 1
  echo "$(grep -o '"id":[0-9]*' <<<"$o" | head -1 | cut -d: -f2) $(grep -o '"focus":[a-z]*' <<<"$o" | head -1 | cut -d: -f2)"
}
activate() { "${WC[@]}" --method org.gnome.Shell.Extensions.Windows.Activate "$1" >/dev/null 2>&1; }

if read -r id focused < <(rofi_win); then
  if [[ "$focused" == true ]]; then pkill -x rofi; else activate "$id"; fi
  exit 0
fi

rofi -normal-window -modi "$modi" -show "$mode" &
pid=$!
seen=0
for ((i = 0; i < 100; i++)); do   # up to 20 s; rofi ends first when you pick something
  kill -0 "$pid" 2>/dev/null || exit 0
  if read -r id focused < <(rofi_win); then
    if [[ "$focused" == true ]]; then seen=1
    elif ((seen)); then pkill -x rofi; exit 0      # lost focus: close
    else activate "$id"; fi                         # not focused yet: ask for it
  fi
  sleep 0.2
  ((i > 90)) && ((seen)) && i=50                    # keep watching while it stays open
done
