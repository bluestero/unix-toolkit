#!/usr/bin/env bash
# k-bg: kitty background picker with live preview. `k-bg help` lists the commands.
#
# Images: kitty/backgrounds (override with KBG_DIR). Drop any jpg/png/webp in there.
# One PNG copy per image, cut to your screen's shape, lives in ~/.local/share/k-bg/<WxH>
# (plus dimmed / see-through versions): the picker previews and the final
# background are the same file, so Enter is instant.
# The choice is saved in ~/.config/kitty/background.conf (kitty.conf includes it).
set -uo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
# shellcheck source=../../lib/ui.sh
. "$(cd "$(dirname "$self")/../.." && pwd)/lib/ui.sh"
src_dir=${KBG_DIR:-$(cd "$(dirname "$self")/.." && pwd)/backgrounds}
img_dir=${XDG_DATA_HOME:-$HOME/.local/share}/k-bg
conf=${XDG_CONFIG_HOME:-$HOME/.config}/kitty/background.conf
# Matches remote_control_password in kitty.conf, which only allows the background and colour actions.
rc_pass=k-bg
DEF_BRIGHT=50 DEF_OPACITY=100

# Talks to this kitty over its socket (never the terminal, so it can't clash
# with fzf drawing the list). Usage: rc <action> [args...]
rc() {
  [[ -n "${KITTY_LISTEN_ON:-}" ]] || return 1
  local action=$1; shift
  timeout 3 kitty @ --to "$KITTY_LISTEN_ON" --password="$rc_pass" --use-password=always \
    "$action" --match "id:${KITTY_WINDOW_ID:-1}" "$@" </dev/null >/dev/null 2>&1
}

# kitty's own defaults for the colours accents change (used to switch accents off)
accent_keys=(cursor url_color selection_background selection_foreground active_border_color active_tab_background active_tab_foreground inactive_tab_background inactive_tab_foreground tab_bar_background)
accent_off=(cursor=#cccccc url_color=#0087bd selection_background=#fffacd selection_foreground=#000000
  active_border_color=#00ff00 active_tab_background=#eeeeee active_tab_foreground=#000000
  inactive_tab_background=#999999 inactive_tab_foreground=#444444 tab_bar_background=none)

names() {
  find "$src_dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    -printf '%f\n' 2>/dev/null | sed 's/\.[^.]*$//' | sort -u
}

# Always PNG. kitty 0.36+ also takes JPEG, but kitten turns a JPEG into PNG on
# every preview before sending it (~0.5 s each), so PNG is what keeps it quick.
img_ext() { echo png; }

# What a copy is called after its brightness and opacity: 50, 50o80 (80% opaque), …
img_tag() { local t=$1; (( ${2:-100} < 100 )) && t+="o$2"; echo "$t"; }

# The size every copy is made at: your screen's shape (the biggest monitor, from
# GNOME; 16:9 if it can't tell), at most 1600 wide. kitty stretches it to fill
# the window. Bigger copies look no different behind dimmed text but are 2-3 MB
# each (photos barely compress), which makes every preview step slower to send.
# Exported once so the picker's callbacks don't ask again.
KBG_MAX_W=1600
screen_size() {
  if [[ -z "${KBG_SCREEN:-}" ]]; then
    KBG_SCREEN=$(gdbus call --session --dest org.gnome.Mutter.DisplayConfig \
      --object-path /org/gnome/Mutter/DisplayConfig --method org.gnome.Mutter.DisplayConfig.GetCurrentState 2>/dev/null |
      grep -oE "'[0-9]+x[0-9]+@[0-9.]+', [0-9]+, [0-9]+, [^{]*\{[^}]*'is-current'" |
      awk -F', ' '{ if ($2 * $3 > best) { best = $2 * $3; s = $2 "x" $3 } } END { print s }')
    [[ $KBG_SCREEN =~ ^[0-9]+x[0-9]+$ ]] || KBG_SCREEN=1920x1080
    local w=${KBG_SCREEN%x*} h=${KBG_SCREEN#*x}
    (( w > KBG_MAX_W )) && { h=$(( h * KBG_MAX_W / w )); w=$KBG_MAX_W; }
    KBG_SCREEN=${w}x$h
    export KBG_SCREEN
  fi
  echo "$KBG_SCREEN"
}
screen_size >/dev/null

# Image file for a background at a brightness and $OPACITY (made if missing or
# older than the source). Cut to the screen's shape (see screen_size). Opacity is baked into the PNG's alpha channel: since kitty 0.43
# that's how a background image gets see-through (background_opacity no longer
# applies to it), and it means opacity previews live like brightness.
# Temp files carry the process id: the picker's background job and a preview may
# make the same file at once.
# Usage: img_for <name> [bright]
img_for() {
  local name=$1 bright=${2:-100} op=${OPACITY:-100} size dir ext src base out enc fx=()
  [[ "$name" == none ]] && { echo none; return; }
  size=$(screen_size) dir=$img_dir/$size ext=$(img_ext)
  enc=(-define png:compression-level=1)
  src=$(find "$src_dir" -maxdepth 1 -type f -name "$name.*" -print -quit 2>/dev/null)
  [[ -n "$src" ]] || return 1
  mkdir -p "$dir"
  base="$dir/$name.$ext"
  if [[ ! -f "$base" || "$src" -nt "$base" ]]; then
    command -v convert >/dev/null || return 1
    convert "$src" -resize "$size^" -gravity center -extent "$size" -strip "${enc[@]}" "$base.$BASHPID.tmp.$ext" 2>/dev/null \
      && mv -f "$base.$BASHPID.tmp.$ext" "$base" || { rm -f "$base.$BASHPID.tmp.$ext"; return 1; }
  fi
  (( bright >= 100 && op >= 100 )) && { echo "$base"; return; }
  (( bright < 100 )) && fx+=(-fill black -colorize "$(( 100 - bright ))%")
  (( op < 100 )) && fx+=(-alpha set -channel A -evaluate set "$op%" +channel)
  out="$dir/$name@$(img_tag "$bright" "$op").$ext"
  if [[ ! -f "$out" || "$base" -nt "$out" ]]; then
    convert "$base" "${fx[@]}" "${enc[@]}" "$out.$BASHPID.tmp.$ext" 2>/dev/null \
      && mv -f "$out.$BASHPID.tmp.$ext" "$out" || { rm -f "$out.$BASHPID.tmp.$ext"; echo "$base"; return; }
  fi
  echo "$out"
}

# Accent colours for a background: "<accent> <second accent> <selection>", cached
# next to its preview image. The hue comes from the most vivid colour the image has
# plenty of; saturation is pushed up and lightness raised until the colour has at
# least 4.5:1 contrast with the image's average colour, so it's in the image's
# family but never blends in. The second accent is 40° round the colour wheel.
# Reds are moved to coral or pink (red stays the prod/error colour). Grey images
# (and "none") get a neutral-ish blue.
accent_raw() {  # <name> [brightness]: contrast is checked against the image as dimmed
  local name=$1 bright=${2:-$DEF_BRIGHT} base cache
  [[ "$name" == none ]] && { echo "#7aa2f7 #bb9af7 #2b3a63"; return; }
  base=$(OPACITY=100 img_for "$name" 100) || { echo "#7aa2f7 #bb9af7 #2b3a63"; return; }
  cache="${base%.*}@$bright.accent"
  if [[ ! -f "$cache" || "$base" -nt "$cache" ]]; then
    convert "$base" -resize '80x80!' -colors 16 -depth 8 -format %c histogram:info:- 2>/dev/null |
      python3 -I -c '
import colorsys, re, sys
dim = int(sys.argv[1]) / 100
cols = []
for line in sys.stdin:
    m = re.search(r"(\d+):\s*\((\d+),(\d+),(\d+)", line)
    if m: cols.append(tuple(int(x) for x in m.groups()))
total = sum(c[0] for c in cols) or 1
avg = [dim * sum(c[0] * c[i] for c in cols) / total / 255 for i in (1, 2, 3)]
best, best_score = None, 0.0
for n, r, g, b in cols:
    h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
    if l < 0.06 or s < 0.12: continue
    score = n * s ** 1.5
    if score > best_score: best, best_score = h, score
hue = 0.62 if best is None else best
def lum(rgb):
    f = lambda c: c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (f(c) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b
def contrast(a, b):
    la, lb = sorted((lum(a), lum(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)
def vivid(h):
    # red means prod/errors in the prompt: nudge reds to coral or pink
    deg = h * 360
    if deg >= 345 or deg < 18: h = (18 if deg < 18 else 330) / 360
    l = 0.55
    while l < 0.86 and contrast(colorsys.hls_to_rgb(h, l, 0.9), avg) < 4.5: l += 0.02
    return colorsys.hls_to_rgb(h, l, 0.9)
hexc = lambda rgb: "#%02x%02x%02x" % tuple(round(c * 255) for c in rgb)
print(hexc(vivid(hue)), hexc(vivid((hue + 40 / 360) % 1)), hexc(colorsys.hls_to_rgb(hue, 0.30, 0.55)))
' "$bright" >"$cache.tmp" && [[ -s "$cache.tmp" ]] && mv -f "$cache.tmp" "$cache" || rm -f "$cache.tmp"
  fi
  cat "$cache" 2>/dev/null || echo "#7aa2f7 #bb9af7 #2b3a63"
}
# The whole text palette for a background: foreground and the 16 ANSI colours, cached
# like the accents. Every hue is tied to the image's accent hue but kept apart from
# the image: lightness is raised (or lowered, for a bright image) until the colour has
# 4.5:1 contrast (7:1 for the main text) with the image's bright areas (its 85th
# percentile), not only its average. Red, green and yellow keep their meaning (they
# only lean up to 10-15° towards the image's hue); blue is the UI accent slot and takes
# the image's hue (kept 25° off red, yellow and green); cyan and magenta lean further;
# the greys and the text colour are tinted with the image's hue.
palette_raw() {  # <name> [brightness] -> "foreground=#.. color0=#.. ..."
  local name=$1 bright=${2:-$DEF_BRIGHT} base cache acc _
  [[ "$name" == none ]] && return 0
  base=$(OPACITY=100 img_for "$name" 100) || return 0
  cache="${base%.*}@$bright.palette"
  if [[ ! -f "$cache" || "$base" -nt "$cache" ]]; then
    read -r acc _ <<<"$(accent_raw "$name" "$bright")"
    convert "$base" -resize '24x24!' -depth 8 txt:- 2>/dev/null |
      python3 -I -c '
import colorsys, re, sys
dim = int(sys.argv[1]) / 100
acc = sys.argv[2].lstrip("#")
hue = colorsys.rgb_to_hls(*(int(acc[i:i + 2], 16) / 255 for i in (0, 2, 4)))[0] * 360
def lum(rgb):
    f = lambda c: c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (f(c) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b
lums = sorted(lum([dim * int(x) / 255 for x in m.groups()])
              for m in re.finditer(r"\((\d+),(\d+),(\d+)", sys.stdin.read()))
ref = lums[int(len(lums) * 0.85)] if lums else 0.0
light = ref <= 0.18          # light text suits the image; otherwise dark text
def contrast(l): return (max(l, ref) + 0.05) / (min(l, ref) + 0.05)
def fit(h, s, l0, need, cap=0.82):
    # stops at cap even if the contrast is not reached: a colour pushed to near-white
    # has lost its hue, which matters more than the last bit of contrast on a pale image
    l = l0 if light else 1 - l0
    step = 0.02 if light else -0.02
    while 1 - cap < l < cap and contrast(lum(colorsys.hls_to_rgb(h / 360, l, s))) < need: l += step
    return colorsys.hls_to_rgb(h / 360, l, s), (l if light else 1 - l)
def toward(base, span):
    d = (hue - base + 180) % 360 - 180
    return (base + max(-span, min(span, d))) % 360
hexc = lambda rgb: "#%02x%02x%02x" % tuple(round(c * 255) for c in rgb)
out = {}
out["foreground"] = hexc(fit(hue, 0.35, 0.88, 7, 0.96)[0])
out["color0"] = hexc(colorsys.hls_to_rgb(hue / 360, 0.14, 0.3))
out["color7"] = hexc(fit(hue, 0.20, 0.80, 7, 0.96)[0])
out["color8"] = hexc(fit(hue, 0.20, 0.55, 4.5, 0.75)[0])
out["color15"] = hexc(fit(hue, 0.40, 0.96, 10, 0.97)[0])
def clear_of_meaning(h):
    # the blue slot is the UI accent (key hints, titles): it takes the image hue, but
    # stays 25° away from red, yellow and green so those keep their meaning
    for m in (0, 50, 125):
        d = (h - m + 180) % 360 - 180
        if abs(d) < 25: h = (m + (25 if d >= 0 else -25)) % 360
    return h
for n, base, span in ((1, 0, 10), (2, 125, 15), (3, 50, 10), (4, None, 0), (5, 300, 25), (6, 180, 15)):
    h = clear_of_meaning(hue) if base is None else toward(base, span)
    if base is None: blue = h
    elif n in (5, 6):   # cyan and magenta keep 35° from the blue slot, on their own side
        d = (h - blue + 180) % 360 - 180
        if abs(d) < 35:
            side = (base - blue + 180) % 360 - 180
            h = (blue + (35 if side >= 0 else -35)) % 360
    rgb, l = fit(h, 0.85, 0.55, 4.5)
    out["color%d" % n] = hexc(rgb)
    out["color%d" % (n + 8)] = hexc(fit(h, 0.95, min(l + 0.08, 0.86), 4.5)[0])
print(" ".join("%s=%s" % kv for kv in out.items()))
' "$bright" "$acc" >"$cache.tmp" && [[ -s "$cache.tmp" ]] && mv -f "$cache.tmp" "$cache" || rm -f "$cache.tmp"
  fi
  cat "$cache" 2>/dev/null
}
# kitty settings (key=#hex ...) for a background: its accents and its text palette.
# Nothing for "none": k-theme's colours apply then (see colors_set).
accent_for() {  # <name> [brightness]
  local acc acc2 sel pal c0 c8; [[ "$1" == none ]] && return 0
  read -r acc acc2 sel <<<"$(accent_raw "$1" "${2:-}")"
  pal=$(palette_raw "$1" "${2:-}")
  c0=$(grep -o 'color0=#[0-9a-fA-F]*' <<<"$pal"); c0=${c0#*=}
  c8=$(grep -o 'color8=#[0-9a-fA-F]*' <<<"$pal"); c8=${c8#*=}
  # inactive tabs and the tab bar follow the image too (not the k-theme theme's greys)
  echo "cursor=$acc url_color=$acc selection_background=$sel selection_foreground=#ffffff" \
       "active_border_color=$acc active_tab_background=$acc active_tab_foreground=#16161e" \
       "${c0:+inactive_tab_background=$c0} ${c8:+inactive_tab_foreground=$c8} tab_bar_background=none" \
       "$pal"
}
# Sends a background's colours to kitty; "none" (or accents off) puts k-theme's back:
# kitty's defaults, then the theme file. Usage: colors_set <name> <bright> [set-colors flags...]
colors_set() {
  local name=$1 bright=$2 d=${XDG_DATA_HOME:-$HOME/.local/share}/k-theme/default.conf files=()
  shift 2
  if [[ "$name" == none ]]; then
    [[ -f "$d" ]] && files+=("$d")
    [[ -f "$(dirname "$conf")/theme.conf" ]] && files+=("$(dirname "$conf")/theme.conf")
    rc set-colors "$@" "${accent_off[@]}" "${files[@]}"
  else
    # shellcheck disable=SC2046
    rc set-colors "$@" $(accent_for "$name" "$bright")
  fi
}

# The accents outside kitty: the prompt (starship) and the toolkit's pickers and
# lists (lib/ui.sh) read them from here. Usage: share_accents <name> <brightness> | off
theme_dir=${XDG_STATE_HOME:-$HOME/.local/state}/k-bg
share_accents() {
  mkdir -p "$theme_dir"
  if [[ "$1" == off ]]; then rm -f "$theme_dir/accent"
  else accent_raw "$1" "$2" | cut -d' ' -f1,2 >"$theme_dir/accent"; fi
  sync_prompt
  "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/k-rofi" 2>/dev/null || true
}
# A copy of your starship.toml with the accents in it (shell/init.sh points
# STARSHIP_CONFIG here). The directory and ❯ take the accent, the git branch the
# second one; red prod warnings and errors stay red. Accents off = plain copy.
sync_prompt() {
  local src=${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml
  [[ -r "$src" ]] || return 0
  mkdir -p "$theme_dir"
  python3 -I - "$src" "$theme_dir/accent" "$theme_dir/starship.toml" <<'PY' || true
import os, re, sys, tomllib
src, accent_file, out = sys.argv[1:]
text = open(src).read()
try: acc, acc2 = open(accent_file).read().split()[:2]
except OSError: acc = None
if acc:
    conf = tomllib.loads(text)
    name = conf.get("palette")
    pal = dict(conf.get("palettes", {}).get(name, {}))
    pal.update(sapphire=acc, mauve=acc2, kbg_accent=acc)
    text = re.sub(r'(?m)^palette\s*=.*$', 'palette = "k-bg"', text, count=1)
    text = re.sub(r'(?m)^(success_symbol\s*=\s*"\[[^]]*\]\()bold green(\)")', r"\1bold kbg_accent\2", text)
    text = "# Made by k-bg from " + src + ". Edit that file, not this one.\n" + text
    text += "\n[palettes.k-bg]\n" + "".join(f'{k} = "{v}"\n' for k, v in pal.items())
open(out + ".tmp", "w").write(text)
os.replace(out + ".tmp", out)
PY
}

# Saved choice -> NAME BRIGHT OPACITY (percent) ACCENTS
load_saved() {
  local line
  NAME=none BRIGHT=$DEF_BRIGHT OPACITY=$DEF_OPACITY ACCENTS=on
  line=$(grep -m1 '^# k-bg:' "$conf" 2>/dev/null) || {
    # older background.conf: only the image path
    line=$(sed -n 's/^background_image[[:space:]]\+//p' "$conf" 2>/dev/null | tail -1)
    [[ -n "$line" && "$line" != none ]] && { NAME=$(basename "$line"); NAME=${NAME%.*}; NAME=${NAME%@*}; }
    return 0
  }
  [[ "$line" =~ name=([^ ]+) ]] && NAME=${BASH_REMATCH[1]}
  [[ "$line" =~ bright=([0-9]+) ]] && BRIGHT=${BASH_REMATCH[1]}
  [[ "$line" =~ opacity=([0-9]+)% ]] && OPACITY=${BASH_REMATCH[1]}
  [[ "$line" =~ accents=(on|off) ]] && ACCENTS=${BASH_REMATCH[1]}
  return 0
}

save() {  # name bright image [accent key=value list]
  local kv
  mkdir -p "$(dirname "$conf")"
  {
    echo "# Written by k-bg. Change it with: k-bg"
    echo "# k-bg: name=$1 bright=$2 opacity=$OPACITY% accents=$ACCENTS"
    echo "background_image $3"
    for kv in ${4:-}; do echo "${kv%%=*} ${kv#*=}"; done
  } >"$conf.tmp" && mv -f "$conf.tmp" "$conf"
}

# Usage: apply <name> <bright>
apply() {
  local img ok=1 colors="" dir
  img=$(img_for "$1" "$2") || ui_unknown k-bg "$1" background
  [[ "$ACCENTS" == on ]] && colors=$(accent_for "$1" "$2")
  save "$1" "$2" "$img" "$colors"
  # copies nobody uses any more (they add up fast): other brightness/opacity
  # versions, other screen sizes, and the older layout (preview/, full-size files)
  dir=$img_dir/$(screen_size)
  find "$dir" -maxdepth 1 -name '*@*.png' ! -name "*@$(img_tag "$2" "$OPACITY").png" -delete 2>/dev/null
  find "$img_dir" -mindepth 1 -maxdepth 1 ! -path "$dir" -exec rm -rf {} + 2>/dev/null
  find "$dir" -maxdepth 1 -name '*.tmp.png' -mmin +5 -delete 2>/dev/null   # left by a stopped background job
  rc set-background-image --all --configured "$img" || ok=0
  if [[ "$ACCENTS" == on && "$1" != none ]]; then
    # shellcheck disable=SC2086
    rc set-colors --all --configured $colors || ok=0
    share_accents "$1" "$2"
  else
    colors_set none "$2" --all --configured || ok=0   # no image: k-theme's colours
    share_accents off
  fi
  if (( ok )); then ok "Background ${C_BOLD}$1${C_RESET}  ${C_DIM}brightness $2% · opacity $OPACITY% · accents $ACCENTS${C_RESET}"
  else ok "Background ${C_BOLD}$1${C_RESET}  ${C_DIM}brightness $2% · opacity $OPACITY% · accents $ACCENTS · saved, shows up next time kitty starts${C_RESET}"; fi
  return 0
}

clamp_bright()  { local v=$1; (( v < 0 )) && v=0; (( v > 100 )) && v=100; echo "$v"; }
clamp_opacity() { local v=$1; (( v < 30 )) && v=30; (( v > 100 )) && v=100; echo "$v"; }

# ---- picker callbacks (state in $KBG_STATE: "brightness opacity")
state()  { read -r BRIGHT OPACITY <"$KBG_STATE"; }
# Two lines: the settings you can change (value, then its keys), then the rest.
header() {
  state
  local b=$'\e[1m' r=$'\e[22m'
  printf 'brightness %s  ←/→      opacity %s  shift + ←/→\n↑/↓ browse   enter keep   esc cancel' \
    "$b$(printf '%3s%%' "$BRIGHT")$r" "$b$(printf '%3s%%' "$OPACITY")$r"
}
# Makes every background at the current brightness/opacity in the background, so
# scrolling finds them ready; a newer one (after ←/→) replaces it. Anything not
# ready yet is made on the spot when you land on it.
warm() {
  state
  [[ -f "$KBG_STATE.warm" ]] && kill "$(cat "$KBG_STATE.warm")" 2>/dev/null
  (
    while IFS= read -r n; do
      img_for "$n" "$BRIGHT" >/dev/null
      [[ "${KBG_ACCENTS:-off}" == on ]] && accent_for "$n" "$BRIGHT" >/dev/null
    done < <(names)
  ) </dev/null >/dev/null 2>&1 &
  echo $! >"$KBG_STATE.warm"
}
# Shows <name> at the current brightness without making fzf wait. Requests queue
# on a lock and any that a newer one replaced are skipped, so fast scrolling
# never piles up or lands on an old image.
show() {
  state
  local want="$1 $BRIGHT $OPACITY"
  echo "$want" >"$KBG_STATE.want"
  (
    exec 9>"$KBG_STATE.lock"; flock 9
    [[ "$(cat "$KBG_STATE.want" 2>/dev/null)" == "$want" ]] || exit 0
    img=$(img_for "$1" "$BRIGHT") && rc set-background-image "$img"
    [[ "${KBG_ACCENTS:-off}" == on ]] && colors_set "$1" "$BRIGHT"
  ) </dev/null >/dev/null 2>&1 &
}

cmd_help() {
  ui_help k-bg "kitty background" <<'EOF'
k-bg	picker	↑↓ preview · ←→ brightness · shift+←→ opacity
k-bg <name>	set a background	k-bg iss-aurora
k-bg ls	every background
k-bg status	background, brightness, opacity, accents
k-bg current	the background in use, name only
k-bg off	no background image
k-bg bright <0-100>	image brightness in %	100 = untouched
k-bg opacity <30-100>	see-through image in %	100 = solid; kitty 0.43+
k-bg accents on|off	palette from the image	all text, prompt, pickers, cursor, tabs; red/green/yellow keep their meaning · no image: k-theme
k-bg help	this page

Images: kitty/backgrounds (or KBG_DIR). Drop any jpg/png/webp in there.
The choice is saved in ~/.config/kitty/background.conf and applies to every window.
EOF
}

cmd_ls() {
  [[ -t 1 ]] || ui_no_color
  local n
  load_saved
  { printf '%s\n' "  ${C_BOLD}BACKGROUND${C_RESET}"
    { echo none; names; } | while IFS= read -r n; do
      if [[ "$n" == "$NAME" ]]; then printf '%s\n' "$(ui_mark_here) ${C_BOLD}$n${C_RESET}"; else printf '  %s\n' "$n"; fi
    done
  } | ui_table "k-bg · backgrounds" "$(ui_mark_here) in use"
}

cmd_status() {
  [[ -t 1 ]] || ui_no_color
  load_saved
  printf 'background\t%s\nbrightness\t%s\nopacity\t%s\naccents\t%s\napplies to\tevery kitty window\n' \
    "${C_BOLD}$NAME${C_RESET}" "$BRIGHT%" "$OPACITY%" "$ACCENTS" | ui_fields k-bg
}

cmd_accents() {
  [[ "${1:-}" == on || "${1:-}" == off ]] || die "Usage: k-bg accents on|off"
  load_saved; ACCENTS=$1
  apply "$NAME" "$BRIGHT" || exit
  # apply() already put k-theme's colours back when accents are off
  return 0
}

case "${1:-}" in
  "") ;;   # the picker, below
  help|-h|--help) cmd_help; exit 0 ;;
  ls|list)        cmd_ls; exit 0 ;;
  st|status)      cmd_status; exit 0 ;;
  cur|current)    load_saved; echo "$NAME"; exit 0 ;;
  off)            load_saved; apply none "$BRIGHT"; exit ;;
  accents)        cmd_accents "${2:-}"; exit ;;
  bright)
    [[ "${2:-}" =~ ^[0-9]+$ ]] || die "Usage: k-bg bright <0-100>"
    load_saved; apply "$NAME" "$(clamp_bright "$2")"; exit ;;
  opacity)
    [[ "${2:-}" =~ ^[0-9]+$ ]] || die "Usage: k-bg opacity <30-100>  (percent; 100 = solid)"
    load_saved; OPACITY=$(clamp_opacity "$2"); apply "$NAME" "$BRIGHT"; exit ;;
  # internal: picker callbacks, tab completion, install.sh, shell/init.sh
  __preview) show "${2:-none}"; exit 0 ;;
  __nudge)   # __nudge bright|opacity <delta> <name>
    state
    if [[ "$2" == opacity ]]; then OPACITY=$(clamp_opacity $(( OPACITY + $3 )))
    else BRIGHT=$(clamp_bright $(( BRIGHT + $3 ))); fi
    echo "$BRIGHT $OPACITY" >"$KBG_STATE"
    show "${4:-none}"
    warm
    exit 0 ;;
  __header)        header; exit 0 ;;
  __names)         names; exit 0 ;;
  __accents_state) load_saved; echo "$ACCENTS"; exit 0 ;;
  __sync_prompt)   sync_prompt; exit 0 ;;
  __colors)        accent_for "${2:-none}" "${3:-$DEF_BRIGHT}"; exit 0 ;;   # what a background sets
  -*) ui_unknown k-bg "$1" ;;
  *)
    [[ "$1" == none ]] || names | grep -qxF "$1" || ui_unknown k-bg "$1" background
    load_saved; apply "$1" "$BRIGHT"; exit ;;
esac

# ---- picker
command -v fzf >/dev/null || die "the picker needs fzf · see: k-bg ls"
[[ -t 0 && -t 1 ]] || { cmd_ls; exit 0; }

all=$(names)
[[ -n "$all" ]] || die "No images in $src_dir"
load_saved
orig_name=$NAME orig_bright=$BRIGHT orig_opacity=$OPACITY

preview=1
if [[ -z "${KITTY_WINDOW_ID:-}" ]]; then
  preview=0; warn "Not inside kitty: no live preview, the choice applies next time kitty starts."
elif ! rc set-background-image "$(img_for "$NAME" "$BRIGHT" || echo none)"; then
  preview=0; warn "No live preview: this kitty was started before the k-bg settings. Quit kitty fully and reopen it. (Your pick is still saved.)"
fi

export KBG_STATE KBG_ACCENTS=$ACCENTS
KBG_STATE=$(mktemp)
trap '[[ -f "$KBG_STATE.warm" ]] && kill "$(cat "$KBG_STATE.warm")" 2>/dev/null
  rm -f "$KBG_STATE" "$KBG_STATE.want" "$KBG_STATE.lock" "$KBG_STATE.warm"' EXIT
echo "$BRIGHT $OPACITY" >"$KBG_STATE"
(( preview )) && warm

pos=1 i=0 list=""
while IFS= read -r n; do
  (( ++i ))
  if [[ "$n" == "$NAME" ]]; then list+="$(ui_mark_here)"$'\t'"$n"$'\n'; pos=$i; else list+=" "$'\t'"$n"$'\n'; fi
done <<<"none"$'\n'"$all"

q="'$self'"
opts=(--prompt='background> ' --delimiter=$'\t' --nth=2 --tabstop=2 --header="$(header)"
  --bind "load:pos($pos)")
if (( preview )); then
  opts+=(--bind "focus:execute-silent($q __preview {2})"
    --bind "right:execute-silent($q __nudge bright 10 {2})+transform-header($q __header)"
    --bind "left:execute-silent($q __nudge bright -10 {2})+transform-header($q __header)"
    --bind "shift-right:execute-silent($q __nudge opacity 5 {2})+transform-header($q __header)"
    --bind "shift-left:execute-silent($q __nudge opacity -5 {2})+transform-header($q __header)")
fi

pick=$(printf '%s' "$list" | ui_fzf 'k-bg · kitty background' "${opts[@]}")
# drop queued previews and let a running one finish, so none lands after this
echo done >"$KBG_STATE.want"
flock "$KBG_STATE.lock" true 2>/dev/null
if [[ -z "$pick" ]]; then
  if (( preview )); then
    rc set-background-image "$(OPACITY=$orig_opacity img_for "$orig_name" "$orig_bright" || echo none)"
    [[ "$ACCENTS" == on ]] && colors_set "$orig_name" "$orig_bright"
  fi
  info "${C_DIM}Cancelled. Background unchanged ($orig_name).${C_RESET}"
  exit 0
fi
state
apply "${pick#*$'\t'}" "$BRIGHT"
