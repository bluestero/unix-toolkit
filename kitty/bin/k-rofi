#!/usr/bin/env bash
# k-rofi: write rofi's colours (~/.config/rofi/colors.rasi) from the colours kitty
# is using: the k-theme theme, plus what k-bg adds on top (accent, text, selection).
# k-theme and k-bg run this on every change, so rofi follows them. Run it by hand
# to refresh. Usage: k-rofi
set -uo pipefail
cfg=${XDG_CONFIG_HOME:-$HOME/.config}
out=$cfg/rofi/colors.rasi
mkdir -p "${out%/*}"
# later files win, like in kitty (theme first, then the background's colours)
cat "$cfg/kitty/theme.conf" "$cfg/kitty/background.conf" 2>/dev/null | awk '
  /^[a-z_0-9]+[ \t]+#[0-9a-fA-F]{6}[ \t]*$/ { c[$1] = tolower($2) }
  function g(k, d) { return (k in c) ? c[k] : d }
  END {
    printf "/* Written by k-rofi from the kitty colours in use. Do not edit; change them with k-theme / k-bg. */\n"
    printf "* {\n"
    printf "    bg:     %sf0;\n", g("background", "#16161e")
    printf "    fg:     %s;\n",   g("foreground", "#dddddd")
    printf "    grey:   %s;\n",   g("color8", "#a0a0a0")
    printf "    accent: %s;\n",   g("cursor", g("color12", "#1a8fff"))
    printf "    sel:    %s26;\n", g("foreground", "#dddddd")
    printf "    line:   %s40;\n", g("foreground", "#dddddd")
    printf "}\n"
  }' >"$out.tmp" && mv -f "$out.tmp" "$out"
