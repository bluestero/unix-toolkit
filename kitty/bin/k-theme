#!/usr/bin/env bash
# k-theme: kitty colour theme picker with live preview. `k-theme help` lists the commands.
#
# Themes come from two places:
#   yours   ~/.config/kitty/themes/*.conf and the team's kitty/themes/*.conf (KTHEME_DIR).
#           Drop a downloaded .conf in there, or: k-theme add <file or URL>
#   kitty   kitty's own collection (400+), downloaded once into ~/.local/share/k-theme
# Mine is your short list (names in ~/.config/k-theme/mine, everyone has their own);
# All is everything. The picker opens on Mine.
# The choice is saved in ~/.config/kitty/theme.conf (kitty.conf includes it, before
# background.conf, so while a k-bg image is set its palette wins; with no image, the theme shows).
# Only colour lines are ever copied out of a theme file: a downloaded theme can't
# change any other kitty setting.
set -uo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
# shellcheck source=../../lib/ui.sh
. "$(cd "$(dirname "$self")/../.." && pwd)/lib/ui.sh"
team_dir=${KTHEME_DIR:-$(cd "$(dirname "$self")/.." && pwd)/themes}
kdir=${XDG_CONFIG_HOME:-$HOME/.config}/kitty
own_dirs=("$kdir/themes" "$team_dir")
mine_file=${XDG_CONFIG_HOME:-$HOME/.config}/k-theme/mine
conf=$kdir/theme.conf
bgconf=$kdir/background.conf
kbg=$(dirname "$self")/k-bg
data=${XDG_DATA_HOME:-$HOME/.local/share}/k-theme
zip_url=https://codeload.github.com/kovidgoyal/kitty-themes/zip/master
# `kitten themes` keeps the same download here; whichever is newer is used.
kitten_zip=${XDG_CACHE_HOME:-$HOME/.cache}/kitty/kitty-themes.zip
# Matches remote_control_password in kitty.conf (allows set-colors only).
rc_pass=k-theme

# Talks to this kitty over its socket. Falls back to k-bg's password, which also
# allows set-colors, for a kitty started before the k-theme line was in kitty.conf.
# Usage: rc <args for set-colors...>
rc() {
  [[ -n "${KITTY_LISTEN_ON:-}" ]] || return 1
  local p
  for p in "$rc_pass" k-bg; do
    timeout 3 kitty @ --to "$KITTY_LISTEN_ON" --password="$p" --use-password=always \
      set-colors --match "id:${KITTY_WINDOW_ID:-1}" "$@" </dev/null >/dev/null 2>&1 && return 0
  done
  return 1
}

# kitty's built-in colours. Sent before every theme, so a theme that leaves a
# colour out gets kitty's default, not the last theme's.
defaults_file() {
  local f=$data/default.conf
  [[ -s "$f" ]] && { echo "$f"; return; }
  mkdir -p "$data"
  cat >"$f" <<'EOF'
foreground #dddddd
background #000000
selection_foreground #000000
selection_background #fffacd
cursor #cccccc
cursor_text_color #111111
url_color #0087bd
active_border_color #00ff00
inactive_border_color #cccccc
bell_border_color #ff5a00
active_tab_foreground #000000
active_tab_background #eeeeee
inactive_tab_foreground #444444
inactive_tab_background #999999
tab_bar_background none
tab_bar_margin_color none
mark1_foreground #000000
mark1_background #98d3cb
mark2_foreground #000000
mark2_background #f2dcd3
mark3_foreground #000000
mark3_background #f274bc
color0 #000000
color8 #767676
color1 #cc0403
color9 #f2201f
color2 #19cb00
color10 #23fd00
color3 #cecb00
color11 #fffd00
color4 #0d73cc
color12 #1a8fff
color5 #cb1ed1
color13 #fd28ff
color6 #0dcdcd
color14 #14ffff
color7 #dddddd
color15 #ffffff
EOF
  echo "$f"
}

# The colour lines of a theme file, nothing else (no include, shell, listen_on...).
colours_of() {
  awk 'NF == 2 && $1 ~ /^(cursor|color[0-9]+|[a-z0-9_]*(color|ground))$/ &&
       ($2 ~ /^#[0-9a-fA-F]+$/ && (length($2) == 4 || length($2) == 7) || $2 ~ /^(none|background|foreground)$/) {
         print $1 " " $2 }' "$1" 2>/dev/null   # (no {3} in the regex: mawk has no intervals)
}

# override on = the theme's colours beat the k-bg palette (k-bg accents off)
override_on() { grep -q '^# k-bg:.*accents=off' "$bgconf" 2>/dev/null; }

# k-bg accent colours (cursor, selection, tabs), as key=value, when accents are on.
accents() { awk 'NF == 2 && $1 !~ /^#/ && $2 ~ /^#/ { print $1 "=" $2 }' "$bgconf" 2>/dev/null; }

# ---- the list: name<TAB>kind<TAB>file, yours first
newest_zip() {
  local z=$data/kitty-themes.zip
  [[ -f "$kitten_zip" && ( ! -f "$z" || "$kitten_zip" -nt "$z" ) ]] && z=$kitten_zip
  [[ -f "$z" ]] && echo "$z"
}
# Unpacks kitty's collection into $data/kitty (once, and again when the download is newer).
unpack() {
  local z idx=$data/kitty/index.tsv
  z=$(newest_zip) || return 1
  [[ -s "$idx" && "$idx" -nt "$z" ]] && return 0
  mkdir -p "$data/kitty"
  python3 -I - "$z" "$data/kitty" <<'PY'
import json, os, re, sys, zipfile
src, out = sys.argv[1:]
z = zipfile.ZipFile(src)
root = next(n for n in z.namelist() if n.endswith("/themes.json"))[: -len("themes.json")]
rows = []
for t in json.loads(z.read(root + "themes.json")):
    name = t.get("name", "").replace("\t", " ").strip()
    if not name or name == "Default":
        continue
    fname = re.sub(r"[^A-Za-z0-9_.-]", "_", os.path.basename(t["file"]))
    try:
        data = z.read(root + t["file"])
    except KeyError:
        continue
    with open(os.path.join(out, fname), "wb") as f:
        f.write(data)
    rows.append(f"{name}\t{'dark' if t.get('is_dark') else 'light'}\t{os.path.join(out, fname)}")
with open(os.path.join(out, "index.tsv.tmp"), "w") as f:
    f.write("\n".join(sorted(rows, key=str.lower)) + "\n")
os.replace(os.path.join(out, "index.tsv.tmp"), os.path.join(out, "index.tsv"))
PY
}
download() {
  mkdir -p "$data"
  curl -fsSL -m 60 --retry 2 -o "$data/kitty-themes.zip.tmp" "$zip_url" &&
    python3 -I -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).testzip()' "$data/kitty-themes.zip.tmp" &&
    mv -f "$data/kitty-themes.zip.tmp" "$data/kitty-themes.zip" || { rm -f "$data/kitty-themes.zip.tmp"; return 1; }
  rm -f "$data/kitty/index.tsv"
  unpack
}
# dark or light, from a theme file's background colour (kitty's own list says it already)
tone_of() {
  local bg; bg=$(awk '$1 == "background" && $2 ~ /^#[0-9a-fA-F]+$/ && length($2) == 7 { print substr($2, 2); exit }' "$1" 2>/dev/null)
  [[ -n "$bg" ]] || { echo dark; return; }
  (( 299 * 16#${bg:0:2} + 587 * 16#${bg:2:2} + 114 * 16#${bg:4:2} < 128000 )) && echo dark || echo light
}
# Every theme: name TAB kind (yours | dark | light | kitty default) TAB file TAB dark|light
themes() {
  local d f
  printf 'default\tkitty default\tdefault\tdark\n'
  for d in "${own_dirs[@]}"; do
    for f in "$d"/*.conf; do [[ -f "$f" ]] && printf '%s\tyours\t%s\t%s\n' "$(basename "$f" .conf)" "$f" "$(tone_of "$f")"; done
  done | sort -f -t$'\t' -k1,1
  unpack 2>/dev/null || download >/dev/null 2>&1
  awk -F'\t' '{ print $0 "\t" $2 }' "$data/kitty/index.tsv" 2>/dev/null
}
# The row for a name: exact, then any case, then ignoring spaces/dashes/underscores.
find_theme() {
  local want=$1 key
  key() { tr 'A-Z' 'a-z' <<<"$1" | tr -d ' _-'; }
  themes | awk -F'\t' -v w="$want" -v lw="$(tr 'A-Z' 'a-z' <<<"$want")" -v kw="$(key "$want")" '
    { n = $1; ln = tolower(n); kn = ln; gsub(/[ _-]/, "", kn) }
    n == w   && !a { a = $0 }
    ln == lw && !b { b = $0 }
    kn == kw && !c { c = $0 }
    END { if (a) print a; else if (b) print b; else if (c) print c }'
}

# ---- Mine: one theme name per line. Starts as your own .conf themes plus the one in use.
mine() {
  if [[ ! -f "$mine_file" ]]; then
    mkdir -p "${mine_file%/*}"
    { local d f; for d in "${own_dirs[@]}"; do for f in "$d"/*.conf; do [[ -f "$f" ]] && basename "$f" .conf; done; done
      load_saved; [[ "$NAME" != default ]] && echo "$NAME"
    } | awk 'NF && !seen[$0]++' >"$mine_file"
  fi
  cat "$mine_file"
}
mine_add() {  # names...
  local n added=()
  mine >/dev/null
  for n in "$@"; do
    [[ -z "$n" || "$n" == default ]] && continue
    grep -qxF "$n" "$mine_file" || { echo "$n" >>"$mine_file"; added+=("$n"); }
  done
  ADDED=${#added[@]}
}
mine_rm() {   # names...
  local n tmp; tmp=$(mktemp)
  mine >/dev/null
  cp "$mine_file" "$tmp"
  for n in "$@"; do grep -vxF -- "$n" "$tmp" >"$tmp.2"; mv "$tmp.2" "$tmp"; done
  REMOVED=$(( $(grep -c . "$mine_file") - $(grep -c . "$tmp") ))
  cat "$tmp" >"$mine_file"; rm -f "$tmp"
}

# Saved choice -> NAME
load_saved() {
  NAME=default
  local line; line=$(grep -m1 '^# k-theme:' "$conf" 2>/dev/null) || return 0
  NAME=${line#*name=}
}

# btop colours from the kitty theme in use, so btop follows k-theme: writes
# ~/.config/btop/themes/kitty.theme (btop.conf: color_theme = "kitty") and asks a running
# btop to reload. Usage: btop_theme <theme file or "default">
btop_theme() {
  local file=$1 out=${XDG_CONFIG_HOME:-$HOME/.config}/btop/themes/kitty.theme
  mkdir -p "${out%/*}"
  { colours_of "$(defaults_file)"; [[ "$file" == default ]] || colours_of "$file"; } | awk '
    { c[$1] = $2 }
    function g(k, d) { return (k in c && c[k] ~ /^#/) ? c[k] : d }
    function t(k, v) { printf "theme[%s]=\"%s\"\n", k, v }
    END {
      t("main_bg", g("background", "#000000")); t("main_fg", g("foreground", "#dddddd"))
      t("title", g("foreground", "#dddddd")); t("hi_fg", g("color12", "#1a8fff"))
      t("selected_bg", g("selection_background", g("color8", "#767676")))
      t("selected_fg", g("foreground", "#dddddd")); t("inactive_fg", g("color8", "#767676"))
      t("proc_misc", g("color14", "#14ffff"))
      t("cpu_box", g("color4", "#0d73cc")); t("mem_box", g("color2", "#19cb00"))
      t("net_box", g("color5", "#cb1ed1")); t("proc_box", g("color1", "#cc0403"))
      t("div_line", g("color8", "#767676")); t("graph_text", g("foreground", "#dddddd"))
      t("meter_bg", g("color8", "#767676"))
      split("temp cpu process", gr, " ")
      for (i in gr) { t(gr[i] "_start", g("color2", "#19cb00")); t(gr[i] "_mid", g("color3", "#cecb00")); t(gr[i] "_end", g("color1", "#cc0403")) }
      t("free_start", g("color2", "#19cb00")); t("free_mid", g("color10", "#23fd00")); t("free_end", g("color10", "#23fd00"))
      t("cached_start", g("color4", "#0d73cc")); t("cached_mid", g("color12", "#1a8fff")); t("cached_end", g("color12", "#1a8fff"))
      t("available_start", g("color3", "#cecb00")); t("available_mid", g("color11", "#fffd00")); t("available_end", g("color11", "#fffd00"))
      t("used_start", g("color1", "#cc0403")); t("used_mid", g("color9", "#f2201f")); t("used_end", g("color9", "#f2201f"))
      t("download_start", g("color4", "#0d73cc")); t("download_mid", g("color12", "#1a8fff")); t("download_end", g("color14", "#14ffff"))
      t("upload_start", g("color5", "#cb1ed1")); t("upload_mid", g("color13", "#fd28ff")); t("upload_end", g("color13", "#fd28ff"))
    }' | { echo "# Written by k-theme from the kitty theme in use. Don't edit; change it with: k-theme"; cat; } >"$out.tmp" &&
    mv -f "$out.tmp" "$out"
  pkill -USR2 -x btop 2>/dev/null || true
}

# Usage: apply <name> <file>   (file "default" = kitty's own colours)
apply() {
  local name=$1 file=$2 ok=1
  # shellcheck disable=SC2046
  if [[ "$file" == default ]]; then
    rm -f "$conf"
    rc --all --configured "$(defaults_file)" $(accents) || ok=0
  else
    [[ -n "$(colours_of "$file")" ]] || die "$name has no colour lines, so it isn't a kitty theme"
    mkdir -p "$kdir"
    { echo "# Written by k-theme from ${file/#$HOME/\~}. Change it with: k-theme"
      echo "# k-theme: name=$name"
      colours_of "$file"
    } >"$conf.tmp" && mv -f "$conf.tmp" "$conf"
    rc --all --configured "$(defaults_file)" "$conf" $(accents) || ok=0
  fi
  btop_theme "$file"
  "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/k-rofi" 2>/dev/null || true
  if (( ok )); then ok "Theme ${C_BOLD}$name${C_RESET}"
  else ok "Theme ${C_BOLD}$name${C_RESET}  ${C_DIM}saved, shows up next time kitty starts${C_RESET}"; fi
}

# ---- picker callbacks: previews queue on a lock, and any that a newer one replaced are skipped
show() {
  local file=$1
  echo "$file" >"$KTH_STATE.want"
  (
    exec 9>"$KTH_STATE.lock"; flock 9
    [[ "$(cat "$KTH_STATE.want" 2>/dev/null)" == "$file" ]] || exit 0
    if [[ "$file" == default ]]; then
      # shellcheck disable=SC2046
      rc "$(defaults_file)" $(accents)
    else
      colours_of "$file" >"$KTH_STATE.conf"
      # shellcheck disable=SC2046
      rc "$(defaults_file)" "$KTH_STATE.conf" $(accents)
    fi
  ) </dev/null >/dev/null 2>&1 &
}

cmd_help() {
  ui_help k-theme "kitty colour theme" <<'EOF'
k-theme	picker	↑↓ preview live · type to search · ←→ Mine / All
k-theme <name>	use a theme	k-theme "Tokyo Night"
k-theme ls	Mine (ls all: every theme)
k-theme add <name>	add a theme to Mine	k-theme add Dracula
k-theme add <file|URL> [name]	import a downloaded .conf (goes in Mine too)
k-theme rm <name>	take a theme off Mine (an imported file stays)
k-theme status	the theme in use and where it's from
k-theme current	the theme in use, name only
k-theme default	kitty's own colours again
k-theme override on|off	theme colours beat the k-bg palette	on: the image stays, the colours are the theme's
k-theme btop	write btop's colours from the theme in use (done on every change)
k-theme update	download kitty's theme collection again
k-theme help	this page

## In the picker
type	search (the name, or dark / light / yours)
←/→	switch between Mine and All (All = everything not in Mine)
ctrl-a	All: move to Mine (tab ticks several first)
ctrl-d	Mine: move back to All
ctrl-f	show all → only dark → only light (both tabs)
enter / esc	keep the theme / put the old one back

Imported themes go in ~/.config/kitty/themes; the team's are in kitty/themes. Only colour
lines are used. While a k-bg image is set (accents on) its palette wins; k-theme override on shows the theme.
EOF
}

# Colours for the list: the theme's own palette (bright yellow/blue/magenta), so they follow it.
STAR=$'\e[93m★\e[0m'
tone_col() {  # dark | light -> coloured
  if [[ $1 == light ]]; then printf '%s' $'\e[93m'"light$C_RESET"; else printf '%s' $'\e[96m'"dark$C_RESET"; fi
}
kind_col() {  # <kind> <tone> -> coloured label: "dark", "light · yours", "kitty default"
  case $1 in
    yours) printf '%s' "$(tone_col "$2") ${C_DIM}·$C_RESET ${C_CYAN}yours$C_RESET" ;;
    dark|light) tone_col "$1" ;;
    *) printf '%s' $'\e[95m'"$1$C_RESET" ;;
  esac
}

# Rows: <marks>TAB<name>TAB<kind>TAB<file>TAB<dark|light>.
# Usage: rows <mine|all|every> [all|dark|light]
#   mine   your list (kitty's default is always in it)
#   all    everything that isn't in Mine (adding one moves it over)
#   every  both, ★ marking the ones in Mine (k-theme ls all)
# Marks: ● in use, ★ in Mine.
rows() {
  local tab=${1:-mine} tone=${2:-all}
  load_saved; mine >/dev/null
  themes | awk -F'\t' -v tab="$tab" -v tone="$tone" -v cur="$NAME" -v minef="$mine_file" \
      -v here="$(ui_mark_here)" -v star="$STAR" '
    BEGIN { while ((getline l < minef) > 0) mine[l] = 1 }
    seen[$1]++ { next }   # the same name twice: yours wins over kitty'"'"'s
    {
      inm = ($1 in mine) || $3 == "default"
      if (tab == "mine" && !inm) next
      if (tab == "all" && inm) next
      if (tone != "all" && $4 != tone) next
      m = ($1 == cur ? here : " ") (tab == "every" && inm && $3 != "default" ? star : " ")
      print m "\t" $1 "\t" $2 "\t" $3 "\t" $4
    }'
}

cmd_ls() {
  [[ -t 1 ]] || ui_no_color
  local tab=mine m name kind file tone
  [[ "${1:-}" == all ]] && tab=every
  { printf '%s\n' "   ${C_BOLD}THEME${C_RESET}"$'\x1f'"${C_BOLD}TYPE${C_RESET}"
    while IFS=$'\t' read -r m name kind file tone; do
      [[ "$m" == *●* ]] && name="${C_BOLD}$name${C_RESET}"
      printf '%s\n' "$m $name"$'\x1f'"$(kind_col "$kind" "$tone")"
    done < <(rows "$tab")
  } | ui_table "k-theme · $([[ $tab == every ]] && echo "every theme" || echo mine)" \
      "$(ui_mark_here) in use$([[ $tab == every ]] && echo "  $STAR in Mine")" \
      "$(ui_hint "$([[ $tab == every ]] && echo 'k-theme add <name> puts one in Mine' || echo 'k-theme ls all: every theme')")"
}

cmd_status() {
  [[ -t 1 ]] || ui_no_color
  local row from accent=off
  load_saved
  row=$(find_theme "$NAME")
  case "$(cut -f2 <<<"$row")" in
    yours) from="yours · $(cut -f3 <<<"$row" | sed "s|^$HOME|~|")" ;;
    dark|light) from="kitty's collection" ;;
    *) from="kitty" ;;
  esac
  [[ -n "$(accents)" ]] && accent="on (the background's palette colours all text; k-theme override on shows this theme)"
  printf 'theme\t%s\nfrom\t%s\nin Mine\t%s\nk-bg accents\t%s\napplies to\tevery kitty window\n' \
    "${C_BOLD}$NAME${C_RESET}" "$from" "$(mine | grep -c .) themes" "$accent" | ui_fields k-theme
}

# add <name>: into Mine. add <file|URL> [name]: import into ~/.config/kitty/themes, then Mine.
cmd_add() {
  local src=${1:-} name=${2:-} tmp dest row
  [[ -n "$src" ]] || die "Usage: k-theme add <theme name | file | URL> [name]"
  if [[ ! "$src" =~ ^https?:// && ! -f "$src" ]]; then
    row=$(find_theme "$src")
    [[ -n "$row" ]] || ui_unknown k-theme "$src" theme
    mine_add "$(cut -f1 <<<"$row")"
    if (( ADDED )); then ok "Added ${C_BOLD}$(cut -f1 <<<"$row")${C_RESET} to Mine"; else ok "$(cut -f1 <<<"$row") is in Mine already"; fi
    return
  fi
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' RETURN
  if [[ "$src" =~ ^https?:// ]]; then
    curl -fsSL -m 30 -o "$tmp" "$src" || die "couldn't download $src"
    [[ -n "$name" ]] || { name=${src%%\?*}; name=$(basename "$name" .conf); }
  else
    cp "$src" "$tmp"
    [[ -n "$name" ]] || name=$(basename "$src" .conf)
  fi
  name=$(tr -c 'A-Za-z0-9_.+-' '-' <<<"$name" | sed 's/-*$//')
  (( $(colours_of "$tmp" | wc -l) >= 8 )) || die "that doesn't look like a kitty theme (needs lines like: color1 #ff5555)"
  mkdir -p "$kdir/themes"
  dest=$kdir/themes/$name.conf
  if [[ -e "$dest" ]] && ! cmp -s "$tmp" "$dest"; then die "${dest/#$HOME/\~} exists already; pick another name: k-theme add $src <name>"; fi
  cp "$tmp" "$dest"
  mine_add "$name"
  ok "Added ${C_BOLD}$name${C_RESET} to Mine ${C_DIM}(${dest/#$HOME/\~})${C_RESET}  $(ui_hint "k-theme $name, or pick it in: k-theme")"
}

cmd_rm() {
  [[ -n "${1:-}" ]] || die "Usage: k-theme rm <name>"
  local row name; row=$(find_theme "$*"); name=$(cut -f1 <<<"$row")
  [[ -n "$name" ]] || name=$*
  mine_rm "$name"
  if (( REMOVED )); then ok "Took ${C_BOLD}$name${C_RESET} off Mine ${C_DIM}(k-theme add $name puts it back)${C_RESET}"
  else ok "$name isn't in Mine"; fi
}

# ---- picker state ($KTH_STATE): "<tab> <tone>"
pstate() { read -r TAB TONE <"$KTH_STATE" 2>/dev/null; TAB=${TAB:-mine} TONE=${TONE:-all}; }
KEYS_MINE="←→: Mine / All · ctrl-d: remove from Mine · ctrl-f: dark / light / all · tab: tick several
alt-s: sort · alt-←→: column · alt-shift-←→: move it · ctrl-o: override · enter: keep · esc: cancel"
KEYS_ALL="←→: Mine / All · ctrl-a: add to Mine · ctrl-f: dark / light / all · tab: tick several
alt-s: sort · alt-←→: column · alt-shift-←→: move it · ctrl-o: override · enter: keep · esc: cancel"
# The header: the two tabs (the open one lit up) and the dark/light filter, then the
# shared key hints (ui_keys).
header() {
  ui_color; pstate
  local r=$C_RESET mine_n all_n tabs tones="" t ov
  if override_on; then ov="$C_BOLD${C_CYAN}on$r"; else ov="${C_WORD}off$r"; fi
  mine_n=$(cat "$KTH_STATE.mine_n" 2>/dev/null) all_n=$(cat "$KTH_STATE.all_n" 2>/dev/null)
  tabs=$(ui_tabs "$([[ $TAB == mine ]] && echo 0 || echo 1)" "Mine $mine_n" "All $all_n")
  for t in all dark light; do
    if [[ $t == "$TONE" ]]; then tones+=" $C_BOLD$C_CYAN$t$r"; else tones+=" $C_WORD$t$r"; fi
  done
  # the column titles stay under it; a resize wraps the keys again (ui_sort_keys)
  ui_sort_keys "$([[ $TAB == all ]] && echo "$KEYS_ALL" || echo "$KEYS_MINE")" \
    "$(printf '%s     %s%s     %s %s' "$tabs" "${C_WORD}show:$r" "$tones" "${C_WORD}override:$r" "$ov")"
}
# The list for the open tab: a table of \x1f cells (ui_fzf lays it out, again on a
# resize), each row followed by TAB name TAB file for the preview and the pick, the
# column heads first (--header-lines=1; a reload brings them along, sorted by
# ui_sort_feed). The ● mark goes right before the name. Also saves the tab counts.
plist() {
  ui_color; pstate
  local m name kind file tone n
  rows mine "$TONE" | grep -c . >"$KTH_STATE.mine_n"
  rows all "$TONE" | grep -c . >"$KTH_STATE.all_n"
  local pad="  "; [[ $TAB == every ]] && pad="   "   # every: room for ★ too
  printf '%s\n' "$pad${C_BOLD}THEME${C_RESET}"$'\x1f'"${C_BOLD}TYPE${C_RESET}"$'\t\t'
  while IFS=$'\t' read -r m name kind file tone; do
    [[ $TAB == every ]] || m=${m% }   # no ★ slot in Mine / All
    [[ "$m" == *●* ]] && n="$m ${C_BOLD}$name${C_RESET}" || n="$m $name"
    printf '%s\n' "$n"$'\x1f'"$(kind_col "$kind" "$tone")"$'\t'"$name"$'\t'"$file"
  done < <(rows "$TAB" "$TONE")
}
# A key in the picker -> the fzf actions for it.
key() {
  local k=$1; shift
  local q="'$self'" reload n=""
  pstate
  # The new list is made here, before fzf runs any of the actions: fzf doesn't wait
  # for reload-sync's command before transform-header, so the header could read the
  # last tab's column widths.
  reload="reload-sync($q __rows)+pos(${FZF_POS:-1})+clear-multi+transform-header($q __header)"
  case $k in
    tab)
      [[ $TAB == mine ]] && TAB=all || TAB=mine
      echo "$TAB $TONE" >"$KTH_STATE"
      plist >"$KTH_STATE.list"; echo "${reload/pos(${FZF_POS:-1})/first}" ;;
    tone)
      case $TONE in all) TONE=dark ;; dark) TONE=light ;; *) TONE=all ;; esac
      echo "$TAB $TONE" >"$KTH_STATE"
      plist >"$KTH_STATE.list"; echo "${reload/pos(${FZF_POS:-1})/first}" ;;
    start)   # on opening: say why the theme may look different (footer, gone after 5 s)
      [[ -n "$(accents)" ]] || return 0
      n="${C_YELLOW}!${C_RESET} The background's palette is showing, not the theme · ctrl-o: override"
      reload="" ;;   # no header here: the start bind has just drawn it, and two at once garble it
    override)
      # the image stays; only whose colours show changes. Then the row under the cursor is previewed again.
      if override_on; then "$kbg" accents on; n="${C_GREEN}✓${C_RESET} Override off: the background's palette shows"
      else "$kbg" accents off; n="${C_GREEN}✓${C_RESET} Override on: the theme's colours show"; fi >/dev/null 2>&1
      reload="transform-header($q __header)+execute-silent($q __preview {3})" ;;
    add)
      mine_add "$@"
      plist >"$KTH_STATE.list"
      if (( ADDED )); then n="${C_GREEN}✓${C_RESET} Added $([[ $ADDED == 1 ]] && echo "$1" || echo "$ADDED themes") to Mine"
      else n="${C_DIM}Already in Mine.${C_RESET}"; fi ;;
    remove)
      mine_rm "$@"
      plist >"$KTH_STATE.list"
      if (( REMOVED )); then n="${C_GREEN}✓${C_RESET} Took $([[ $REMOVED == 1 ]] && echo "$1" || echo "$REMOVED themes") off Mine · back in All"
      elif [[ "$*" == default ]]; then n="${C_DIM}kitty's default always stays in Mine.${C_RESET}"
      else n="${C_DIM}Not in Mine.${C_RESET}"; fi ;;
  esac
  # the result in the footer, gone after 5 s (fzf 0.63+: ui_fzf --toast)
  [[ -n "$n" ]] && { [[ -n "${UI_TOAST_DIR:-}" ]] && reload+="+$(ui_toast "$n")"; echo "${reload#+}"; }
}

case "${1:-}" in
  "") ;;   # the picker, below
  help|-h|--help) cmd_help; exit 0 ;;
  ls|list)        cmd_ls "${2:-}"; exit 0 ;;
  st|status)      cmd_status; exit 0 ;;
  cur|current)    load_saved; echo "$NAME"; exit 0 ;;
  add)            shift; if [[ $# -le 2 && ( -f "${1:-}" || "${1:-}" =~ ^https?:// ) ]]; then cmd_add "$@"; else cmd_add "$*"; fi; exit ;;
  rm|remove)      shift; cmd_rm "$@"; exit ;;
  default|off|none) apply default default; exit ;;
  override)
    case "${2:-}" in
      on)  "$(dirname "$self")/k-bg" accents off ;;
      off) "$(dirname "$self")/k-bg" accents on ;;
      *)   die "Usage: k-theme override on|off  (on: theme colours beat the k-bg palette)" ;;
    esac
    exit ;;
  btop)           load_saved; row=$(find_theme "$NAME"); f=default; [[ -n "$row" ]] && f=$(cut -f3 <<<"$row"); btop_theme "$f"; exit 0 ;;   # used by install.sh
  update)
    info "Downloading kitty's theme collection..."
    download || die "download failed (offline?)"
    ok "$(wc -l <"$data/kitty/index.tsv") themes from kitty's collection"; exit 0 ;;
  # internal: picker callbacks, tab completion, install.sh
  __preview) show "${2:-default}"; exit 0 ;;
  __list)    plist; exit 0 ;;
  __rows)    ui_sort_feed <"$KTH_STATE.list"; exit 0 ;;   # the list, in the column sort
  __header)  header; exit 0 ;;   # with the column titles under it (ui_sort_keys)
  __key)     shift; key "$@"; exit 0 ;;
  __names)   themes | cut -f1; exit 0 ;;
  __ready)   [[ -s "$data/kitty/index.tsv" ]] || unpack; exit ;;
  -*) ui_unknown k-theme "$1" ;;
  *)
    row=$(find_theme "$*")
    [[ -n "$row" ]] || ui_unknown k-theme "$*" theme
    apply "$(cut -f1 <<<"$row")" "$(cut -f3 <<<"$row")"; exit ;;
esac

# ---- picker
command -v fzf >/dev/null || die "the picker needs fzf · see: k-theme ls"
[[ -t 0 && -t 1 ]] || { cmd_ls; exit 0; }
load_saved
orig=$NAME

preview=1
if [[ -z "${KITTY_WINDOW_ID:-}" ]]; then
  preview=0; warn "Not inside kitty: no live preview, the choice applies next time kitty starts."
fi
[[ -n "$(themes | sed -n 2p)" ]] || warn "Only kitty's default so far: kitty's collection couldn't be downloaded (offline?). Try: k-theme update"

export KTH_STATE
KTH_STATE=$(mktemp)
trap 'rm -f "$KTH_STATE" "$KTH_STATE".*' EXIT

q="'$self'"
opts=(--delimiter=$'\t' --with-nth=1 --nth=1 --prompt='theme> ')
(( preview )) && focus="execute-silent($q __preview {3})" || focus=""

if ui_fzf_at_least 0.60; then
  # Mine and All tabs, always opening on Mine.
  echo "mine all" >"$KTH_STATE"
  list=$(plist)
  # sortable; the column heads are the last line of the header (ui_sort_keys)
  opts+=(--multi --header-lines=1 --sortable --bind "start:transform-header($q __header)+transform($q __key start)"
    --bind "left:transform($q __key tab)" --bind "right:transform($q __key tab)"
    --bind "ctrl-f:transform($q __key tone)" --bind "ctrl-o:transform($q __key override)"
    --bind "ctrl-a:transform($q __key add {+2})" --bind "ctrl-d:transform($q __key remove {+2})")
  ui_fzf_at_least 0.63 && opts+=(--toast)   # results in the footer, like the kx lists
else
  # older fzf: one list of everything
  echo "every all" >"$KTH_STATE"
  list=$(plist)
  opts+=(--header-lines=1 --header="↑↓: preview · enter: keep · esc: cancel
!fzf 0.60+ adds the Mine / All tabs: tk install fzf")
fi
skip=1   # the column heads row
pos=$(awk -F'\t' -v n="$NAME" -v s=$skip 'NR > s && $2 == n { print NR - s; exit }' <<<"$list")
opts+=(--bind "load:pos(${pos:-1})+unbind(load)")
[[ -n "$focus" ]] && opts+=(--bind "focus:$focus")

pick=$(printf '%s\n' "$list" | ui_fzf 'k-theme · kitty colours' "${opts[@]}" | head -1)
# drop queued previews and let a running one finish, so none lands after this
echo done >"$KTH_STATE.want"
flock "$KTH_STATE.lock" true 2>/dev/null
if [[ -z "$pick" ]]; then
  if (( preview )); then
    # shellcheck disable=SC2046
    if [[ -f "$conf" ]]; then rc "$(defaults_file)" "$conf" $(accents); else rc "$(defaults_file)" $(accents); fi
  fi
  info "${C_DIM}Cancelled. Theme unchanged ($orig).${C_RESET}"
  exit 0
fi
IFS=$'\t' read -r _ name file <<<"$pick"
apply "$name" "$file"
