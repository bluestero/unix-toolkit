#!/usr/bin/env bash
# tk - the work toolkit's front door: find, run, check, set up and update every
# toolkit command from anywhere. `tk help` lists the commands.
#
# The picker hands the chosen command back to your shell (shell/tk.sh) instead of
# running it here, so commands that change this terminal (okcli, kx) still can.

set -uo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=../lib/ui.sh
. "$ROOT/lib/ui.sh"
UI_EVAL_FILE="${TK_EVAL_FILE:-}"
S=$'\x1f'

# Every toolkit command: name | group | what it does | program it needs (if any)
TOOLS=(
  "ctx|Where am I|AWS, Kubernetes and Twingate for this terminal|"
  "hat|Where am I|Claude profile, GitHub account and AWS profile per folder|"
  "okcli|Cloud|Okta AWS profiles: switch, refresh, default, folder pins|okta-aws-cli"
  "kx|Cloud|Kubernetes contexts and namespaces, per terminal|kubectl"
  "twin|Cloud|Twingate exit nodes|twingate"
  "ws|Editor|open workspaces (repos) in your IDE|"
  "k-config|Kitty|edit kitty.conf|kitty"
)
# plus each layer's commands (<layer>/tools, same format; feelkit's k-bg, k-theme, k-icon come this way)
# shellcheck source=../lib/layers.sh
. "$ROOT/lib/layers.sh"
while IFS= read -r _l; do
  [[ -r $_l/tools ]] || continue
  while IFS= read -r _t; do [[ -z $_t || $_t == \#* ]] || TOOLS+=("$_t"); done <"$_l/tools"
done < <(layer_dirs "$ROOT")
unset _l _t
field() { cut -d'|' -f"$2" <<<"$1"; }

# "✓ ready" or why not
ready() {
  local name; name=$(field "$1" 1)
  local need; need=$(field "$1" 4)
  type -P "$name" >/dev/null || { printf '%s' "${C_YELLOW}not on PATH${C_RESET}  $(ui_hint './install.sh commands')"; return 1; }
  [[ -z "$need" ]] || type -P "$need" >/dev/null || { printf '%s' "${C_YELLOW}needs $need${C_RESET}"; return 1; }
  printf '%s' "${C_GREEN}✓ ready${C_RESET}"
}

# -------------------------------------------------------------------- ls ---
cmd_ls() {
  [[ -t 1 ]] || ui_no_color
  local t prev="" g n=0 bad=0 st
  {
    printf '%s\n' "${C_BOLD}COMMAND${C_RESET}$S${C_BOLD}WHAT IT DOES${C_RESET}$S${C_BOLD}READY${C_RESET}"
    for t in "${TOOLS[@]}"; do
      g=$(field "$t" 2)
      if [[ "$g" != "$prev" ]]; then [[ -n "$prev" ]] && printf '\n'; printf '%s\n' "$C_DIM$g$C_RESET"; prev=$g; fi
      st=$(ready "$t") || bad=$((bad + 1))
      printf '%s\n' "  $C_CYAN$(field "$t" 1)$C_RESET$S$(field "$t" 3)$S$st"
    done
  } | ui_table "tk · work toolkit" "${#TOOLS[@]} commands" "$(ui_hint '<command> help for each one')"
}

# ---------------------------------------------------------------- picker ---
cmd_pick() {
  if [[ ! -t 0 || ! -t 1 ]] || ! type -P fzf >/dev/null; then cmd_ls; return; fi
  local t rows="COMMAND${S}AREA${S}WHAT IT DOES"$'\n' sel
  for t in "${TOOLS[@]}"; do
    rows+="$(field "$t" 1)$S${C_DIM}$(field "$t" 2)${C_RESET}$S$(field "$t" 3)"$'\n'
  done
  sel=$(printf '%s' "$rows" | ui_fzf 'tk · work toolkit' --sortable --header-lines=1 --prompt='command> ' \
    --header='enter: run it · esc: cancel') || return 0
  sel=$(strip_ansi "$sel"); sel=${sel%% *}
  [[ -n "$sel" ]] || return 0
  # run it in the calling shell (so okcli / kx can change this terminal)
  emit_eval "$sel" || exec "$sel"
}

# ---------------------------------------------------------------- status ---
# Which installer components are in place. First line, the toolkit's (./install.sh):
# "installed total not-yet-names"; then one per standalone layer (fk install):
# "<layer> <command> installed total"
toolkit_state() {
  (
    repo=$ROOT mode=dry details=0
    # shellcheck source=../lib/setup.sh
    . "$ROOT/lib/setup.sh" >/dev/null 2>&1
    # shellcheck source=../lib/components.sh
    . "$ROOT/lib/components.sh" >/dev/null 2>&1
    local id n=0 total=0 left="" l
    count() {
      n=0 total=0 left=""
      for id in "$@"; do
        "$(fn state "$id")" >/dev/null 2>&1
        [[ "$STATE" == n/a || "$STATE" == unsupported ]] && continue
        total=$((total + 1))
        if [[ "$STATE" == installed ]]; then n=$((n + 1)); else left+="$id "; fi
      done
    }
    count $(main_parts); printf '%s %s %s\n' "$n" "$total" "$left"
    for l in "${!STANDALONE[@]}"; do count $(layer_parts "$l"); printf '%s %s %s %s\n' "$l" "${STANDALONE[$l]}" "$n" "$total"; done
  )
}
# "feelkit  6 of 11 set up → fk install" for each standalone layer, from toolkit_state's lines
layer_lines() {
  local l c n total
  while read -r l c n total; do
    [[ -n $l ]] || continue
    if (( n == total )); then printf '%s\t%s\n' "$l" "${C_GREEN}all $total parts set up${C_RESET}"
    else printf '%s\t%s\n' "$l" "$n of $total parts set up  $(ui_hint "$c install")"; fi
  done
}

cmd_status() {
  "$ROOT/bin/ctx"
  [[ -t 1 ]] || ui_no_color
  local n total left setup update state layers
  state=$(toolkit_state)
  read -r n total left <<<"${state%%$'\n'*}"
  layers=$(tail -n +2 <<<"$state" | layer_lines)
  if [[ -z "$left" ]]; then setup="${C_GREEN}all $total parts set up${C_RESET}"
  else setup="${C_YELLOW}$n of $total parts set up${C_RESET}  $(ui_hint "tk install ${left% }")"; fi
  if git -C "$ROOT" rev-parse >/dev/null 2>&1; then update="$(version) ${C_DIM}($(git_rev))${C_RESET}  $(ui_hint 'tk update')"
  else update="${C_DIM}not a git repo, so no updates${C_RESET}"; fi
  printf 'folder\t%s\nset up\t%s\n%sversion\t%s\n' "${ROOT/#$HOME/\~}" "$setup" "${layers:+$layers$'\n'}" "$update" | ui_fields "tk · toolkit"
}

# ---------------------------------------------------------------- doctor ---
# Every check in one box: one line per tool when all is well, the problems
# (with their fix) when not.
declare -A OKS=() PROBLEMS=()
ORDER=()
check() {  # check <tool> <ok|bad> <text> [fix]
  [[ " ${ORDER[*]} " == *" $1 "* ]] || ORDER+=("$1")
  if [[ "$2" == ok ]]; then OKS[$1]=$(( ${OKS[$1]:-0} + 1 ))
  else PROBLEMS[$1]+="$3${4:+  $(ui_hint "$4")}"$'\n'; fi
}
from_doctor() {  # a tool's own "✓ x" / "! x — fix" lines
  local tool=$1 line text
  while IFS= read -r line; do
    case "$line" in
      "✓ "*) check "$tool" ok "${line#✓ }" ;;
      "! "*) text=${line#! }
             if [[ "$text" == *" — "* ]]; then check "$tool" bad "${text%% — *}" "${text#* — }"
             else check "$tool" bad "$text"; fi ;;
    esac
  done < <("$tool" doctor 2>&1 | sed 's/\x1b\[[0-9;]*m//g')
}

cmd_doctor() {
  [[ -t 1 ]] || ui_no_color
  local tool need t n total left bad=0 rows="" p first
  for tool in okcli kx; do type -P "$tool" >/dev/null && from_doctor "$tool"; done
  if ! type -P twingate >/dev/null; then check twin bad "twingate isn't installed" "tk install twingate"
  elif [[ "$(twingate status -d 2>/dev/null | head -n1)" == online ]]; then check twin ok "connected"
  else check twin bad "Twingate isn't connected" "open the Twingate app"; fi
  for t in "${TOOLS[@]}"; do
    tool=$(field "$t" 1); need=$(field "$t" 4)
    [[ " okcli kx twin " == *" $tool "* ]] && continue
    if ! type -P "$tool" >/dev/null; then check "$tool" bad "not on PATH" "tk install commands"
    elif [[ -n "$need" ]] && ! type -P "$need" >/dev/null; then check "$tool" bad "needs $need"
    else check "$tool" ok ready; fi
  done
  if [[ -n "${KX_SHELL:-}" && -n "${OKCLI_SHELL:-}" ]]; then check tk ok "shell hooks"
  else check tk bad "shell hooks aren't loaded" "tk install bash"; fi
  type -P fzf >/dev/null && check tk ok fzf || check tk bad "fzf isn't installed (the pickers need it)"
  local state l c
  state=$(toolkit_state)
  read -r n total left <<<"${state%%$'\n'*}"
  if [[ -z "$left" ]]; then check tk ok parts
  else check tk bad "$n of $total installer parts set up" "tk install ${left% }"; fi
  # a standalone layer (feelkit): its own line, with its command when parts are left
  while read -r l c n total; do
    [[ -n $l ]] || continue
    if (( n == total )); then check "$l" ok parts; else check "$l" bad "$n of $total parts set up" "$c install"; fi
  done < <(tail -n +2 <<<"$state")

  for tool in "${ORDER[@]}"; do
    if [[ -z "${PROBLEMS[$tool]:-}" ]]; then
      n=${OKS[$tool]}
      rows+="$C_CYAN$tool$C_RESET$S${C_GREEN}✓${C_RESET} $( (( n > 1 )) && echo "all $n checks pass" || echo ok)"$'\n'
      continue
    fi
    first="$C_CYAN$tool$C_RESET"
    while IFS= read -r p; do
      [[ -n "$p" ]] || continue
      rows+="$first$S${C_YELLOW}!${C_RESET} $p"$'\n'; first=""; bad=$((bad + 1))
    done <<<"${PROBLEMS[$tool]}"
    n=${OKS[$tool]:-0}
    (( n == 1 )) && rows+="$S${C_DIM}1 other check passes${C_RESET}"$'\n'
    (( n > 1 )) && rows+="$S${C_DIM}$n other checks pass${C_RESET}"$'\n'
  done

  local foot; (( bad )) && foot="${C_YELLOW}$bad to fix${C_RESET}" || foot="${C_GREEN}all good${C_RESET}"
  printf '%s' "$rows" | { if [[ -t 1 ]]; then print_table 3 | ui_box "tk doctor" "" 0 "$foot"; else print_table 3; fi; }
  (( bad == 0 ))
}

# --------------------------------------------------------------- version ---
# The VERSION file holds the release number (bump it when pushing a change the
# team will notice); git adds the exact commit.
version() { tr -d '[:space:]' <"$ROOT/VERSION" 2>/dev/null || printf 'unknown'; }
git_rev() { git -C "$ROOT" log -1 --format="%h, %cs" 2>/dev/null; }

cmd_version() {
  local rev; rev=$(git_rev)
  printf 'tk %s%s\n' "$(version)" "${rev:+  $C_DIM($rev)$C_RESET}"
}

# ---------------------------------------------------------------- update ---
# <dir> is a git clone of its own (a layer copied in by hand is part of nothing,
# and git would otherwise answer for the toolkit repo around it)
own_repo() { [[ "$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" == "$(cd "$1" && pwd -P)" ]]; }

# pull_one <dir> <name> <changed file>: pull it, say what changed, add the changed files
# (full paths) to <changed file>
pull_one() {
  local before
  before=$(git -C "$1" rev-parse HEAD)
  git -C "$1" pull --ff-only -q || { warn "$2: git pull failed (output above); left as it was"; return 1; }
  [[ "$(git -C "$1" rev-parse HEAD)" == "$before" ]] && { ok "$2: already up to date"; return 1; }
  ok "$2: updated"
  git -C "$1" log --no-merges --format='  • %s' "$before..HEAD" | head -n 20 >&2
  git -C "$1" diff --name-only "$before" HEAD | sed "s#^#$1/#" >>"$3"
}

# parts_now: "id repo state" for every installer part, the standalone layers' too
parts_now() {
  (
    repo=$ROOT mode=dry details=0
    . "$ROOT/lib/setup.sh" >/dev/null 2>&1
    . "$ROOT/lib/components.sh" >/dev/null 2>&1
    for id in "${COMPONENTS[@]}"; do
      component_state "$id" >/dev/null 2>&1
      printf '%s %s %s\n' "$id" "$(repo_of "$id")" "$STATE"
    done
  )
}

# Look for updates to the toolkit and every layer (fetch: nothing changes yet), pull the ones you
# tick (all ticked; enter pulls them), then show each part against how it was before the pull
# (install.sh --update, lib/update.sh): what to fix, what's new, what was removed. Nothing
# changes without asking. --yes pulls them all; --dry-run and no terminal pull nothing.
cmd_update() {
  own_repo "$ROOT" ||
    die "the toolkit folder (${ROOT/#$HOME/\~}) isn't a git repo, so there's nothing to update from"
  local old new d u name n a how=ask rc=0 rows="" layers=0 nsel
  local -a dirs=() names=() picked=()
  for a in "$@"; do case $a in -y|--yes) how=yes ;; -n|--dry-run) how=dry ;; esac; done   # the last one wins, as in install.sh
  u=$(mktemp -d); : >"$u/changed"
  info "${C_DIM}Checking what's set up…${C_RESET}"
  parts_now >"$u/before"
  info "${C_DIM}Looking for updates…${C_RESET}"
  while IFS= read -r d; do
    [[ $d == "$ROOT" ]] && name=toolkit || name=$(basename "$d")
    own_repo "$d" && git -C "$d" rev-parse -q --verify '@{u}' >/dev/null || continue   # no remote to update from
    git -C "$d" fetch -q 2>/dev/null || { warn "$name: couldn't look for updates (offline?)"; continue; }
    n=$(git -C "$d" rev-list --count 'HEAD..@{u}')
    (( n )) || { ok "$name: already up to date"; continue; }
    dirs+=("$d") names+=("$name"); [[ $name == toolkit ]] || layers=1
    git -C "$d" log --no-merges --format='• %s' 'HEAD..@{u}' | head -n 20 >"$u/log.$name"
    old=$(version) new=$(git -C "$ROOT" show '@{u}:VERSION' 2>/dev/null | tr -d '[:space:]')
    a=""; [[ $name == toolkit && -n $new && $new != "$old" ]] && a="$old → $new"
    rows+="$name"$'\x1f'"$n new commit$( (( n == 1 )) || echo s)"$'\x1f'"$C_DIM$a$C_RESET"$'\t'"$name"$'\n'
  done < <(printf '%s\n' "$ROOT"; layer_dirs "$ROOT")

  if (( ${#names[@]} )); then
    if [[ $how == yes ]]; then picked=("${names[@]}")
    elif [[ $how == ask && -t 0 && -t 1 ]] && type -P fzf >/dev/null; then
      local note="" foot=()
      [[ " ${names[*]} " == *" toolkit "* ]] && (( layers )) &&
        note="# layers may need the newer toolkit: keep it ticked when you pull a layer"$'\n'
      ui_fzf_at_least 0.63 && foot=(--footer=' ' --bind="focus:transform-footer(cat $u/log.{2})")
      nsel="$u/nsel"
      a=$(printf '%s%s' "REPO"$'\x1f'"NEW"$'\x1f'"VERSION"$'\t\n' "$rows" |
        ui_fzf 'tk update · pull which?' --multi --marker='✓' --header-lines=1 --delimiter=$'\t' --with-nth=1 \
          --header="${note}tab: tick/untick · ctrl-a: all/none · enter: pull the ticked · esc: pull nothing" \
          --bind='load:select-all+first,ctrl-a:toggle-all' "${foot[@]}" \
          --bind="enter:execute-silent(echo \$FZF_SELECT_COUNT >$nsel)+accept" | cut -f2) ||
        { rm -rf "$u"; info "Cancelled. Nothing pulled."; return 0; }
      mapfile -t picked <<<"$a"
      [[ $(cat "$nsel" 2>/dev/null) == 0 ]] && picked=()   # nothing ticked: fzf hands back the cursor's row
    else   # no terminal to pick in, or --dry-run: say what's there, pull nothing
      printf '%s' "$rows" | cut -f1 | { printf '%s\n' "REPO"$'\x1f'"NEW"$'\x1f'"VERSION"; cat; } |
        ui_table "tk update" "${#names[@]} with updates" >&2
      for name in "${names[@]}"; do sed "s/^/  $name: /" "$u/log.$name" >&2; done
      info "Nothing pulled: ${C_BOLD}tk update${C_RESET} in a terminal picks what to pull; --yes pulls them all"
    fi
    for d in "${dirs[@]}"; do
      [[ $d == "$ROOT" ]] && name=toolkit || name=$(basename "$d")
      if [[ " ${picked[*]} " == *" $name "* ]]; then
        old=$(version)
        pull_one "$d" "$([[ $name == toolkit ]] || echo "layer ")$name" "$u/changed"
        [[ $name == toolkit && $(version) != "$old" ]] && ok "tk $old → ${C_BOLD}$(version)${C_RESET}"
      elif [[ $how == ask && -t 0 && -t 1 ]]; then info "${C_DIM}$name: not pulled (tk update again any time)${C_RESET}"; fi
    done
  fi
  "$ROOT/install.sh" --update="$u" "$@" || rc=$?
  rm -rf "$u"
  return "$rc"
}

# ---------------------------------------------------------------- layers ---
# Extra parts from other repos, in layers/<name>/ (lib/layers.sh says what a
# layer can hold). tk layer add clones one; copying a folder there works too.
layer_ls() {
  [[ -t 1 ]] || ui_no_color
  local d n=0 from ver rows="${C_BOLD}LAYER${C_RESET}$S${C_BOLD}FROM${C_RESET}$S${C_BOLD}VERSION${C_RESET}"$'\n'
  while IFS= read -r d; do
    n=$((n + 1))
    if own_repo "$d"; then
      from=$(git -C "$d" remote get-url origin 2>/dev/null || echo "a git repo with no remote")
      ver=$(git -C "$d" log -1 --format='%h, %cs' 2>/dev/null)
    else from="${C_DIM}a copied folder (no updates)${C_RESET}"; ver="–"; fi
    rows+="  $C_CYAN$(basename "$d")$C_RESET$S$from$S$ver"$'\n'
  done < <(layer_dirs "$ROOT")
  (( n )) || { info "No layers yet. Add one: tk layer add <git-url>"; return 0; }
  printf '%s' "$rows" | ui_table "tk · layers" "$n layer$( (( n > 1 )) && echo s)" "$(ui_hint 'tk layer add <git-url> · tk layer rm <name>')"
}

layer_add() {
  local url=${1:-} name dir
  [[ -n $url ]] || die "which repo? tk layer add <git-url> [name]   e.g. git@github.com:me/acme-toolkit.git"
  name=${2:-$(basename "${url%.git}")}; name=${name#unix-}; name=${name%-toolkit}   # unix-feelkit -> feelkit, acme-toolkit -> acme
  dir="$ROOT/layers/$name"
  [[ -e $dir ]] && die "layers/$name is already there (tk layer ls)"
  mkdir -p "$ROOT/layers"
  git clone -q "$url" "$dir" || die "couldn't clone $url (no access? check: ssh -T git@github.com)"
  ok "layer $name added: ${dir/#$HOME/\~}"
  info "${C_DIM}Its commands and settings load in new terminals.${C_RESET}"
  local later="tk install --layer=$name"
  [[ -f $dir/standalone ]] && later="$(head -1 "$dir/standalone") install"   # set up on its own (fk install)
  confirm "Set up its parts now?" y && exec "$ROOT/install.sh" --layer="$name"
  info "Later: $later"
}

layer_rm() {
  local name=${1:-} dir
  [[ -n $name ]] || die "which layer? tk layer rm <name>   (tk layer ls)"
  dir="$ROOT/layers/$name"
  [[ -d $dir ]] || die "there's no layer $name (tk layer ls)"
  if own_repo "$dir"; then
    if [[ -n $(git -C "$dir" status --porcelain) ]] || ! git -C "$dir" rev-parse '@{u}' >/dev/null 2>&1 ||
       [[ -n $(git -C "$dir" log --oneline '@{u}..') ]]; then
      die "layers/$name has work that isn't pushed (uncommitted, or commits not on its remote). Push it first, or delete the folder yourself."
    fi
  else
    warn "layers/$name isn't a git clone, so deleting it can't be undone"
  fi
  local undo="tk uninstall --layer=$name"
  [[ -f $dir/standalone ]] && undo="$(head -1 "$dir/standalone") uninstall"   # set up on its own (fk uninstall)
  info "${C_DIM}Parts it set up stay set up; to remove them first: $undo${C_RESET}"
  confirm "Remove the $name layer (delete ${dir/#$HOME/\~})?" n || { info "Kept."; return 0; }
  rm -rf "$dir" && ok "layer $name removed · open a new terminal"
}

cmd_layer() {
  case "${1:-ls}" in
    ls|list)    layer_ls ;;
    add)        shift; layer_add "$@" ;;
    rm|remove)  shift; layer_rm "$@" ;;
    *)          ui_unknown "tk layer" "$1" ;;
  esac
}

cmd_help() {
  ui_help tk "the work toolkit" <<'EOF'
## Commands
tk	picker of every toolkit command; enter runs it
tk ls	every toolkit command, what it does, whether it's ready
tk status	ctx, plus how much of the toolkit is set up
tk doctor	every check from every tool, in one box
tk install [part...]	./install.sh from anywhere	tk install zsh
tk uninstall [part...]	./uninstall.sh from anywhere
tk configs	starship, btop, rofi, kitty, readline, yazi keys: the toolkit's preset, the app's default, what you had before, or undo; your own patch on top of each	patches: ~/.config/work-toolkit/patches · edited preset: you changed the toolkit's copy
tk update	what's new in the toolkit and each layer (their commits); pulls the ones you tick, then each part: up to date, needs a fix, new or removed; fixes what you tick	--yes pulls all; no terminal: pulls nothing
tk layer [ls]	the layers: extra parts from other repos, in layers/<name>
tk layer add <git-url> [name]	clone a layer, then offer to set up its parts	name: repo name without -toolkit
tk layer rm <name>	delete a layer (only when nothing in it is unpushed)
tk version	the toolkit version (also -v, --version)
tk help	this page

Every command speaks the same words: ls, status, current, default, off, doctor, help.
EOF
}

case "${1:-}" in
  "")             cmd_pick ;;
  ls|list)        cmd_ls ;;
  st|status)      cmd_status ;;
  doctor)         cmd_doctor ;;
  install)        shift; exec "$ROOT/install.sh" "$@" ;;
  uninstall)      shift; exec "$ROOT/uninstall.sh" "$@" ;;
  update)         shift; cmd_update "$@" ;;
  configs)        shift; exec bash "$ROOT/lib/configs.sh" "$@" ;;
  layer|layers)   shift; cmd_layer "$@" ;;
  version|-v|--version) cmd_version ;;
  __guard)        exec "$ROOT/claude/guard.sh" ;;   # Claude Code's PreToolUse hook (claude-guard)
  help|-h|--help) cmd_help ;;
  *)              ui_unknown tk "$1" ;;
esac
