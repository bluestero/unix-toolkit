+      // work-toolkit patch: stable drop slot while dragging an icon. Uses the real
+      // pointer position against the box on screen, and only changes slot after
+      // the pointer is clearly inside the next one (no back-and-forth flicker).
+      {
+        let origDragOver = dash.handleDragOver.bind(dash);
+        dash.handleDragOver = function (source, actor, x, y, time) {
+          try {
+            let box = this._box;
+            let n = box.get_children().length;
+            let w = box.width;
+            if (this._dragPlaceholder) {
+              w -= this._dragPlaceholder.width;
+              n--;
+            }
+            if (this._separator) {
+              w -= this._separator.width;
+              n--;
+            }
+            let [bx] = box.get_transformed_position();
+            let [tw] = box.get_transformed_size();
+            if (n > 0 && w > 0 && tw > 0 && box.width > 0) {
+              let scale = tw / box.width;
+              let px = global.get_pointer()[0];
+              let rel = px - bx;
+              // the placeholder pushes later icons right by its width: measure
+              // as if it were not there, so the slot is the same either way
+              let ph = this._dragPlaceholder;
+              if (ph) {
+                let [phx] = ph.get_transformed_position();
+                let [phw] = ph.get_transformed_size();
+                if (px >= phx + phw) rel -= phw;
+                else if (px > phx) rel = phx - bx;
+              }
+              let f = ((rel / scale) * n) / w;
+              let cur = this._dragPlaceholderPos;
+              if (cur >= 0 && f > cur - 0.3 && f < cur + 1.3) f = cur + 0.5;
+              if (f < 0) f = 0;
+              x = (f * w) / n;
+            }
+          } catch (err) {
+            console.log(err);
+          }
+          return origDragOver(source, actor, x, y, time);
+        };
+      }
