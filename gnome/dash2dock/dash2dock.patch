+    _maybeShowWindowPicker(c) {
+      let app = c._appwell?.app;
+      if (!app || !app.get_windows) return false;
+      let windows = this.getAppWindowsFiltered(app);
+      if (windows.length < 2) return false;
+      let event = Clutter.get_current_event();
+      let mods = event ? event.get_state() : 0;
+      if (mods & (Clutter.ModifierType.CONTROL_MASK | Clutter.ModifierType.SHIFT_MASK))
+        return false;
+      if (event && event.type() == Clutter.EventType.BUTTON_PRESS &&
+          event.get_button() != 1) return false;
+      this._showWindowPicker(c, windows, -1, true);
+      return true;
+    }
+
+    _closePicker() {
